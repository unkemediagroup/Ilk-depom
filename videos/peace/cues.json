[{"t0": 0.0, "t1": 1.06, "text": "The greatest battle you"}, {"t0": 1.06, "t1": 2.18, "text": "will ever fight is"}, {"t0": 2.18, "t1": 3.82, "text": "not against your enemies,"}, {"t0": 3.82, "t1": 4.64, "text": "your critics,"}, {"t0": 4.64, "t1": 5.44, "text": "or the chaos of"}, {"t0": 5.44, "t1": 6.42, "text": "the world."}, {"t0": 6.42, "t1": 7.16, "text": "It is against the"}, {"t0": 7.16, "t1": 8.46, "text": "energy thieves trying to"}, {"t0": 8.46, "t1": 10.44, "text": "steal your inner calm."}, {"t0": 10.44, "t1": 11.38, "text": "Every time you argue"}, {"t0": 11.38, "t1": 12.44, "text": "with a fool,"}, {"t0": 12.44, "t1": 13.84, "text": "react to toxicity,"}, {"t0": 13.84, "t1": 14.8, "text": "or let someone else's"}, {"t0": 14.8, "t1": 15.94, "text": "storm live inside your"}, {"t0": 15.94, "t1": 16.72, "text": "head,"}, {"t0": 16.72, "t1": 17.54, "text": "you are handing them"}, {"t0": 17.54, "t1": 18.7, "text": "the remote control to"}, {"t0": 18.7, "t1": 20.16, "text": "your emotions."}, {"t0": 20.16, "t1": 21.78, "text": "Stop letting cheap distractions"}, {"t0": 21.78, "t1": 22.86, "text": "rent space in your"}, {"t0": 22.86, "t1": 23.92, "text": "mind."}, {"t0": 23.92, "t1": 25.06, "text": "True strength isn't about"}, {"t0": 25.06, "t1": 25.96, "text": "how loud you can"}, {"t0": 25.96, "t1": 26.46, "text": "roar back."}, {"t0": 26.46, "t1": 28.12, "text": "It's about how calmly"}, {"t0": 28.12, "t1": 29.1, "text": "you can protect your"}, {"t0": 29.1, "t1": 30.32, "text": "boundaries."}, {"t0": 30.32, "t1": 31.34, "text": "You cannot pour from"}, {"t0": 31.34, "t1": 31.96, "text": "a cup that is"}, {"t0": 31.96, "t1": 32.88, "text": "bleeding out through a"}, {"t0": 32.88, "t1": 35.22, "text": "thousand self inflicted leaks."}, {"t0": 35.22, "t1": 37.46, "text": "Guard your space fiercely."}, {"t0": 37.46, "t1": 38.94, "text": "Cut off the noise,"}, {"t0": 38.94, "t1": 40.12, "text": "silence the negativity,"}, {"t0": 40.12, "t1": 41.06, "text": "and protect your peace"}, {"t0": 41.06, "t1": 42.04, "text": "like your life depends"}, {"t0": 42.04, "t1": 43.02, "text": "on it,"}, {"t0": 43.02, "t1": 45.12, "text": "because your success does."}, {"t0": 45.12, "t1": 46.16, "text": "Walk away from the"}, {"t0": 46.16, "t1": 47.0, "text": "drama,"}, {"t0": 47.0, "t1": 48.08, "text": "step into your power,"}, {"t0": 48.08, "t1": 49.42, "text": "protect your peace,"}, {"t0": 49.42, "t1": 50.88, "text": "and watch how unstoppable"}, {"t0": 50.88, "t1": 52.0, "text": "you become."}]