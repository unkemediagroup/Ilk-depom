[{"t0": 0.0, "t1": 1.18, "text": "Nobody is coming to"}, {"t0": 1.18, "t1": 2.2, "text": "save you."}, {"t0": 2.2, "t1": 3.12, "text": "Not tomorrow,"}, {"t0": 3.12, "t1": 4.1, "text": "not next week,"}, {"t0": 4.1, "t1": 4.84, "text": "and not when the"}, {"t0": 4.84, "t1": 6.72, "text": "stars finally align."}, {"t0": 6.72, "t1": 7.68, "text": "The harsh truth is"}, {"t0": 7.68, "t1": 8.58, "text": "that you are entirely"}, {"t0": 8.58, "t1": 10.14, "text": "on your own."}, {"t0": 10.14, "t1": 10.84, "text": "But instead of letting"}, {"t0": 10.84, "t1": 12.14, "text": "that terrify you,"}, {"t0": 12.14, "t1": 12.9, "text": "let it set you"}, {"t0": 12.9, "t1": 13.9, "text": "free."}, {"t0": 13.9, "t1": 14.72, "text": "The moment you realize"}, {"t0": 14.72, "t1": 15.7, "text": "no one else is"}, {"t0": 15.7, "t1": 16.44, "text": "going to build the"}, {"t0": 16.44, "t1": 17.56, "text": "life you want,"}, {"t0": 17.56, "t1": 18.66, "text": "you stop waiting and"}, {"t0": 18.66, "t1": 20.22, "text": "start grinding."}, {"t0": 20.22, "t1": 21.84, "text": "Stop making excuses,"}, {"t0": 21.84, "t1": 22.74, "text": "stop hoping for a"}, {"t0": 22.74, "t1": 23.56, "text": "rescue,"}, {"t0": 23.56, "t1": 24.56, "text": "and become your own"}, {"t0": 24.56, "t1": 25.6, "text": "hero."}, {"t0": 25.6, "t1": 26.56, "text": "The heavy lifting is"}, {"t0": 26.56, "t1": 27.56, "text": "yours alone."}, {"t0": 27.56, "t1": 28.12, "text": "Now,"}, {"t0": 28.12, "t1": 29.0, "text": "go get it!"}]