[{"t0": 0.0, "t1": 2.36, "text": "Motivation is a liar."}, {"t0": 2.36, "t1": 3.02, "text": "It gets you excited"}, {"t0": 3.02, "t1": 4.04, "text": "for a week,"}, {"t0": 4.04, "t1": 5.34, "text": "and then it abandons"}, {"t0": 5.34, "t1": 6.32, "text": "you the second things"}, {"t0": 6.32, "t1": 7.5, "text": "get hard."}, {"t0": 7.5, "t1": 9.0, "text": "Discipline doesn't care how"}, {"t0": 9.0, "t1": 9.98, "text": "you feel."}, {"t0": 9.98, "t1": 11.1, "text": "Discipline wakes up when"}, {"t0": 11.1, "t1": 12.3, "text": "you're exhausted,"}, {"t0": 12.3, "t1": 12.92, "text": "does the work when"}, {"t0": 12.92, "t1": 14.4, "text": "nobody is watching,"}, {"t0": 14.4, "t1": 15.16, "text": "and keeps you moving"}, {"t0": 15.16, "t1": 16.18, "text": "forward when the fire"}, {"t0": 16.18, "t1": 17.58, "text": "goes out."}, {"t0": 17.58, "t1": 18.64, "text": "Feelings change,"}, {"t0": 18.64, "t1": 21.14, "text": "but habits build empires."}, {"t0": 21.14, "t1": 21.92, "text": "Stop waiting to feel"}, {"t0": 21.92, "t1": 23.22, "text": "ready and start acting"}, {"t0": 23.22, "t1": 24.14, "text": "like someone who has"}, {"t0": 24.14, "t1": 25.3, "text": "a mission."}, {"t0": 25.3, "t1": 27.08, "text": "Action creates momentum,"}, {"t0": 27.08, "t1": 28.4, "text": "not mood."}]