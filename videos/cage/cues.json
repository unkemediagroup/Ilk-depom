[{"t0": 0.0, "t1": 1.34, "text": "Safety is a silent"}, {"t0": 1.34, "t1": 2.62, "text": "cage."}, {"t0": 2.62, "t1": 3.66, "text": "You think staying comfortable"}, {"t0": 3.66, "t1": 4.96, "text": "is protecting you,"}, {"t0": 4.96, "t1": 5.74, "text": "but all it's doing"}, {"t0": 5.74, "t1": 7.56, "text": "is quietly murdering your"}, {"t0": 7.56, "t1": 8.64, "text": "potential."}, {"t0": 8.64, "t1": 9.94, "text": "Growth and comfort can"}, {"t0": 9.94, "t1": 10.82, "text": "never live in the"}, {"t0": 10.82, "t1": 11.92, "text": "same room."}, {"t0": 11.92, "t1": 12.74, "text": "Every time you choose"}, {"t0": 12.74, "t1": 14.2, "text": "the easy way out,"}, {"t0": 14.2, "t1": 15.26, "text": "the cozy couch,"}, {"t0": 15.26, "t1": 16.76, "text": "the familiar routine,"}, {"t0": 16.76, "t1": 17.56, "text": "you are trading your"}, {"t0": 17.56, "t1": 19.56, "text": "extraordinary future for temporary"}, {"t0": 19.56, "t1": 20.96, "text": "relief."}, {"t0": 20.96, "t1": 22.36, "text": "Excellence doesn't hide where"}, {"t0": 22.36, "t1": 23.9, "text": "it's warm and cozy."}, {"t0": 23.9, "t1": 24.64, "text": "It lives on the"}, {"t0": 24.64, "t1": 26.02, "text": "other side of fear,"}, {"t0": 26.02, "t1": 26.64, "text": "sweat,"}, {"t0": 26.64, "t1": 27.74, "text": "and uncertainty."}, {"t0": 27.74, "t1": 29.12, "text": "Stop settling for a"}, {"t0": 29.12, "t1": 30.2, "text": "life that is fine"}, {"t0": 30.2, "t1": 31.46, "text": "just because it isn't"}, {"t0": 31.46, "t1": 32.54, "text": "painful."}, {"t0": 32.54, "t1": 33.28, "text": "You were built for"}, {"t0": 33.28, "t1": 34.36, "text": "more than just surviving"}, {"t0": 34.36, "t1": 35.5, "text": "the week."}, {"t0": 35.5, "t1": 36.52, "text": "Break the chains of"}, {"t0": 36.52, "t1": 37.78, "text": "your routine."}, {"t0": 37.78, "t1": 39.48, "text": "Step into the discomfort."}, {"t0": 39.48, "t1": 40.58, "text": "Your greatness is waiting"}, {"t0": 40.58, "t1": 42.06, "text": "on the other side."}, {"t0": 42.06, "t1": 42.9, "text": "Go claim it."}]