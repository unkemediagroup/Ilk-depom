[{"t0": 0.0, "t1": 1.24, "text": "Stop screaming from the"}, {"t0": 1.24, "t1": 2.44, "text": "rooftops about what you're"}, {"t0": 2.44, "t1": 3.74, "text": "going to do."}, {"t0": 3.74, "t1": 5.6, "text": "Stop posting grand plans,"}, {"t0": 5.6, "t1": 6.44, "text": "empty promises,"}, {"t0": 6.44, "t1": 8.1, "text": "and loud declarations to"}, {"t0": 8.1, "t1": 8.8, "text": "a world that is"}, {"t0": 8.8, "t1": 11.4, "text": "already exhausted by talk."}, {"t0": 11.4, "t1": 12.3, "text": "The loudest people in"}, {"t0": 12.3, "t1": 13.26, "text": "the room are almost"}, {"t0": 13.26, "t1": 14.62, "text": "always the ones doing"}, {"t0": 14.62, "t1": 15.66, "text": "the least."}, {"t0": 15.66, "t1": 16.42, "text": "While they are busy"}, {"t0": 16.42, "t1": 17.86, "text": "wasting energy trying to"}, {"t0": 17.86, "t1": 18.98, "text": "convince everyone of their"}, {"t0": 18.98, "t1": 20.0, "text": "potential,"}, {"t0": 20.0, "t1": 21.2, "text": "the true masters are"}, {"t0": 21.2, "t1": 23.36, "text": "working in absolute silence."}, {"t0": 23.36, "t1": 25.04, "text": "They don't need applause."}, {"t0": 25.04, "t1": 26.5, "text": "They don't need validation."}, {"t0": 26.5, "t1": 27.4, "text": "They just put their"}, {"t0": 27.4, "t1": 28.16, "text": "heads down,"}, {"t0": 28.16, "t1": 29.6, "text": "absorb the pressure,"}, {"t0": 29.6, "t1": 30.6, "text": "and let their undeniable"}, {"t0": 30.6, "t1": 32.62, "text": "success shatter every single"}, {"t0": 32.62, "t1": 33.8, "text": "doubt."}, {"t0": 33.8, "t1": 34.92, "text": "Let your actions become"}, {"t0": 34.92, "t1": 36.36, "text": "a shockwave."}, {"t0": 36.36, "t1": 37.66, "text": "Let your relentless execution"}, {"t0": 37.66, "t1": 38.86, "text": "make your critics choke"}, {"t0": 38.86, "t1": 40.8, "text": "on their own words."}, {"t0": 40.8, "t1": 41.96, "text": "Stop talking."}, {"t0": 41.96, "t1": 43.2, "text": "Start building."}, {"t0": 43.2, "t1": 44.22, "text": "Let your results do"}, {"t0": 44.22, "t1": 45.0, "text": "the talking."}]