[{"t0": 0.0, "t1": 2.48, "text": "stop running from solitude."}, {"t0": 2.48, "t1": 3.48, "text": "Most people are terrified"}, {"t0": 3.48, "t1": 4.7, "text": "of being alone with"}, {"t0": 4.7, "t1": 5.76, "text": "their own thoughts,"}, {"t0": 5.76, "t1": 6.96, "text": "so they constantly surround"}, {"t0": 6.96, "t1": 8.44, "text": "themselves with noise,"}, {"t0": 8.44, "t1": 9.08, "text": "distractions,"}, {"t0": 9.08, "t1": 10.8, "text": "and fake company."}, {"t0": 10.8, "t1": 11.98, "text": "But true growth happens"}, {"t0": 11.98, "t1": 13.74, "text": "in the silence."}, {"t0": 13.74, "t1": 14.34, "text": "When you learn to"}, {"t0": 14.34, "t1": 15.72, "text": "embrace solitude,"}, {"t0": 15.72, "t1": 16.74, "text": "you stop seeking validation"}, {"t0": 16.74, "t1": 18.24, "text": "from crowds,"}, {"t0": 18.24, "t1": 19.14, "text": "you discover who you"}, {"t0": 19.14, "t1": 20.24, "text": "really are,"}, {"t0": 20.24, "t1": 20.96, "text": "and you build an"}, {"t0": 20.96, "t1": 23.14, "text": "unshakable inner strength."}, {"t0": 23.14, "t1": 24.16, "text": "Being alone isn't a"}, {"t0": 24.16, "t1": 25.02, "text": "punishment,"}, {"t0": 25.02, "t1": 26.6, "text": "it's the ultimate superpower"}, {"t0": 26.6, "t1": 28.6, "text": "for self -mastery."}]