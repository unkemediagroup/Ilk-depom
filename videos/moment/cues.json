[{"t0": 0.0, "t1": 1.0, "text": "You are holding your"}, {"t0": 1.0, "t1": 2.18, "text": "own breath,"}, {"t0": 2.18, "t1": 3.1, "text": "waiting for a permission"}, {"t0": 3.1, "t1": 4.2, "text": "slip that is never"}, {"t0": 4.2, "t1": 6.06, "text": "going to sign itself."}, {"t0": 6.06, "t1": 7.06, "text": "Look around while you're"}, {"t0": 7.06, "t1": 9.12, "text": "busy polishing your excuses."}, {"t0": 9.12, "t1": 10.3, "text": "Life is passing you"}, {"t0": 10.3, "t1": 11.38, "text": "by."}, {"t0": 11.38, "t1": 12.4, "text": "The calendar will never"}, {"t0": 12.4, "t1": 13.08, "text": "say,"}, {"t0": 13.08, "t1": 14.56, "text": "today is safe."}, {"t0": 14.56, "t1": 15.54, "text": "The stars will never"}, {"t0": 15.54, "t1": 16.48, "text": "align to hand you"}, {"t0": 16.48, "t1": 18.24, "text": "a risk -free victory."}, {"t0": 18.24, "t1": 19.5, "text": "Every single person who"}, {"t0": 19.5, "t1": 20.52, "text": "ever shook the room"}, {"t0": 20.52, "t1": 21.58, "text": "started with a messy"}, {"t0": 21.58, "t1": 22.48, "text": "plan,"}, {"t0": 22.48, "t1": 23.08, "text": "shaking hands,"}, {"t0": 23.08, "t1": 24.42, "text": "and a burning desire"}, {"t0": 24.42, "t1": 26.44, "text": "to change their reality."}, {"t0": 26.44, "t1": 27.18, "text": "They didn't wait for"}, {"t0": 27.18, "t1": 28.0, "text": "the storm to clear."}, {"t0": 28.0, "t1": 29.38, "text": "They learned how to"}, {"t0": 29.38, "t1": 31.14, "text": "run in the rain."}, {"t0": 31.14, "t1": 32.08, "text": "Let go of the"}, {"t0": 32.08, "t1": 33.74, "text": "illusion of control."}, {"t0": 33.74, "t1": 35.22, "text": "Your doubts are loud,"}, {"t0": 35.22, "t1": 36.24, "text": "but your potential is"}, {"t0": 36.24, "t1": 37.38, "text": "deafening."}, {"t0": 37.38, "t1": 38.36, "text": "Stop standing on the"}, {"t0": 38.36, "t1": 39.04, "text": "edge of your own"}, {"t0": 39.04, "t1": 39.98, "text": "life."}, {"t0": 39.98, "t1": 40.52, "text": "Jump,"}, {"t0": 40.52, "t1": 41.22, "text": "adapt,"}, {"t0": 41.22, "t1": 42.38, "text": "and conquer."}, {"t0": 42.38, "t1": 43.46, "text": "Your moment is right"}, {"t0": 43.46, "t1": 44.5, "text": "now."}]