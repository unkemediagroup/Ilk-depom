[{"t0": 0.0, "t1": 1.34, "text": "Stop comparing your chapter"}, {"t0": 1.34, "t1": 2.76, "text": "1 to someone else's"}, {"t0": 2.76, "t1": 4.14, "text": "chapter 20."}, {"t0": 4.14, "t1": 5.24, "text": "Social media is a"}, {"t0": 5.24, "t1": 7.04, "text": "carefully curated highlight reel"}, {"t0": 7.04, "t1": 8.42, "text": "of people's victories,"}, {"t0": 8.42, "t1": 9.46, "text": "while you're living out"}, {"t0": 9.46, "t1": 10.4, "text": "your behind -the -scenes"}, {"t0": 10.4, "t1": 11.28, "text": "struggles,"}, {"t0": 11.28, "t1": 11.9, "text": "doubts,"}, {"t0": 11.9, "t1": 13.2, "text": "and failures."}, {"t0": 13.2, "t1": 13.94, "text": "Every time you measure"}, {"t0": 13.94, "t1": 15.26, "text": "your progress against someone"}, {"t0": 15.26, "t1": 16.72, "text": "else's timeline,"}, {"t0": 16.72, "t1": 17.72, "text": "you rob yourself of"}, {"t0": 17.72, "t1": 18.78, "text": "your own peace and"}, {"t0": 18.78, "t1": 19.9, "text": "momentum."}, {"t0": 19.9, "t1": 21.1, "text": "Your journey is completely"}, {"t0": 21.1, "t1": 22.18, "text": "unique."}, {"t0": 22.18, "t1": 23.14, "text": "Your timeline is your"}, {"t0": 23.14, "t1": 23.72, "text": "own,"}, {"t0": 23.72, "t1": 24.7, "text": "and the only person"}, {"t0": 24.7, "t1": 25.58, "text": "you should ever try"}, {"t0": 25.58, "t1": 26.42, "text": "to beat is the"}, {"t0": 26.42, "t1": 27.5, "text": "person you were yesterday."}, {"t0": 27.5, "t1": 30.2, "text": "Run your own race."}]