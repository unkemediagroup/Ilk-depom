[{"t0": 0.0, "t1": 1.82, "text": "Intensity makes headlines,"}, {"t0": 1.82, "t1": 4.42, "text": "but consistency makes history."}, {"t0": 4.42, "t1": 4.92, "text": "You don't need a"}, {"t0": 4.92, "t1": 6.62, "text": "massive earth shattering breakthrough"}, {"t0": 6.62, "t1": 7.88, "text": "today."}, {"t0": 7.88, "t1": 8.76, "text": "You just need to"}, {"t0": 8.76, "t1": 10.62, "text": "refuse to stop."}, {"t0": 10.62, "t1": 11.64, "text": "Most people fail,"}, {"t0": 11.64, "t1": 12.38, "text": "not because they lack"}, {"t0": 12.38, "t1": 13.14, "text": "talent,"}, {"t0": 13.14, "t1": 14.06, "text": "but because they quit"}, {"t0": 14.06, "t1": 15.44, "text": "in the messy middle,"}, {"t0": 15.44, "t1": 16.68, "text": "blinded by the illusion"}, {"t0": 16.68, "t1": 18.52, "text": "of overnight success."}, {"t0": 18.52, "t1": 19.32, "text": "They want the climax"}, {"t0": 19.32, "t1": 20.7, "text": "without paying the toll"}, {"t0": 20.7, "t1": 22.48, "text": "of the daily grind."}, {"t0": 22.48, "t1": 23.62, "text": "But true power doesn't"}, {"t0": 23.62, "t1": 24.62, "text": "roar."}, {"t0": 24.62, "t1": 25.76, "text": "It drips."}, {"t0": 25.76, "t1": 26.68, "text": "A single drop of"}, {"t0": 26.68, "t1": 27.62, "text": "water feels weak."}, {"t0": 27.62, "t1": 28.62, "text": "Yet,"}, {"t0": 28.62, "t1": 29.8, "text": "given enough time,"}, {"t0": 29.8, "t1": 30.76, "text": "it cuts right through"}, {"t0": 30.76, "t1": 32.16, "text": "solid rock."}, {"t0": 32.16, "t1": 33.96, "text": "That is your blueprint."}, {"t0": 33.96, "t1": 34.7, "text": "Show up when you're"}, {"t0": 34.7, "t1": 35.62, "text": "tired."}, {"t0": 35.62, "t1": 36.22, "text": "Put in the work"}, {"t0": 36.22, "t1": 38.02, "text": "when nobody is watching."}, {"t0": 38.02, "t1": 38.68, "text": "Let your relentless,"}, {"t0": 38.68, "t1": 40.96, "text": "quiet discipline terrify your"}, {"t0": 40.96, "t1": 41.94, "text": "doubts."}, {"t0": 41.94, "t1": 43.28, "text": "Stop chasing bursts of"}, {"t0": 43.28, "t1": 44.4, "text": "motivation."}, {"t0": 44.4, "t1": 45.96, "text": "Become an unstoppable force"}, {"t0": 45.96, "t1": 48.0, "text": "through daily execution."}, {"t0": 48.0, "t1": 49.28, "text": "Your time is coming."}, {"t0": 49.28, "t1": 50.2, "text": "Keep going!"}]