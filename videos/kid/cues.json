[{"t0": 0.0, "t1": 1.16, "text": "Think back."}, {"t0": 1.16, "t1": 1.78, "text": "Look at the kid"}, {"t0": 1.78, "t1": 2.96, "text": "you used to be,"}, {"t0": 2.96, "t1": 3.7, "text": "the one with wide"}, {"t0": 3.7, "t1": 4.52, "text": "eyes,"}, {"t0": 4.52, "t1": 5.84, "text": "impossible dreams,"}, {"t0": 5.84, "t1": 6.6, "text": "and a heart full"}, {"t0": 6.6, "t1": 7.68, "text": "of hope."}, {"t0": 7.68, "t1": 8.3, "text": "What would they say"}, {"t0": 8.3, "t1": 8.98, "text": "if they saw you"}, {"t0": 8.98, "t1": 9.98, "text": "today?"}, {"t0": 9.98, "t1": 10.52, "text": "Would they look up"}, {"t0": 10.52, "t1": 10.84, "text": "to you,"}, {"t0": 10.84, "t1": 12.02, "text": "or would they wonder"}, {"t0": 12.02, "t1": 12.82, "text": "where you lost your"}, {"t0": 12.82, "t1": 13.96, "text": "fire?"}, {"t0": 13.96, "t1": 14.94, "text": "We spend so much"}, {"t0": 14.94, "t1": 15.84, "text": "of our lives trying"}, {"t0": 15.84, "t1": 17.38, "text": "to impress strangers,"}, {"t0": 17.38, "t1": 18.06, "text": "chasing approvals,"}, {"t0": 18.06, "t1": 19.44, "text": "and fitting into boxes"}, {"t0": 19.44, "t1": 20.46, "text": "we were never meant"}, {"t0": 20.46, "t1": 21.24, "text": "for."}, {"t0": 21.24, "t1": 22.2, "text": "We trade our wild"}, {"t0": 22.2, "t1": 24.82, "text": "ambitions for safe compromises."}, {"t0": 24.82, "t1": 25.88, "text": "But deep down,"}, {"t0": 25.88, "t1": 27.04, "text": "your inner child is"}, {"t0": 27.04, "t1": 28.26, "text": "still waiting,"}, {"t0": 28.26, "t1": 29.08, "text": "waiting for you to"}, {"t0": 29.08, "t1": 30.5, "text": "stop breaking promises to"}, {"t0": 30.5, "t1": 31.44, "text": "yourself,"}, {"t0": 31.44, "t1": 32.18, "text": "waiting for you to"}, {"t0": 32.18, "t1": 33.26, "text": "become the fierce,"}, {"t0": 33.26, "t1": 34.84, "text": "unstoppable protector of your"}, {"t0": 34.84, "t1": 36.36, "text": "own dreams."}, {"t0": 36.36, "t1": 37.12, "text": "It's time to stop"}, {"t0": 37.12, "t1": 38.26, "text": "letting fear write your"}, {"t0": 38.26, "t1": 39.18, "text": "story."}, {"t0": 39.18, "t1": 40.06, "text": "Stand up,"}, {"t0": 40.06, "t1": 41.14, "text": "shake off the dust,"}, {"t0": 41.14, "t1": 42.04, "text": "and start living a"}, {"t0": 42.04, "t1": 42.84, "text": "life that makes that"}, {"t0": 42.84, "t1": 43.88, "text": "younger version of you"}, {"t0": 43.88, "t1": 45.88, "text": "proud to be you."}, {"t0": 45.88, "t1": 46.36, "text": "Honor your past,"}, {"t0": 46.36, "t1": 47.68, "text": "own your future,"}, {"t0": 47.68, "t1": 49.32, "text": "become someone they would"}, {"t0": 49.32, "t1": 50.32, "text": "look up to."}, {"t0": 50.32, "t1": 51.5, "text": "Go make it happen."}]