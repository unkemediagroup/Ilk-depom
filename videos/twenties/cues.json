[{"t0": 0.0, "t1": 1.12, "text": "Your 20s are not"}, {"t0": 1.12, "t1": 2.94, "text": "a playground to waste."}, {"t0": 2.94, "t1": 3.6, "text": "They are the concrete"}, {"t0": 3.6, "t1": 5.08, "text": "foundation of your entire"}, {"t0": 5.08, "t1": 6.56, "text": "future."}, {"t0": 6.56, "t1": 7.38, "text": "Every late night you"}, {"t0": 7.38, "t1": 8.92, "text": "spend building skills,"}, {"t0": 8.92, "t1": 10.16, "text": "every sacrifice you make"}, {"t0": 10.16, "t1": 11.66, "text": "while others are partying,"}, {"t0": 11.66, "t1": 12.7, "text": "and every hard lesson"}, {"t0": 12.7, "t1": 14.24, "text": "you swallow is compounding"}, {"t0": 14.24, "t1": 16.26, "text": "interest for your 30s."}, {"t0": 16.26, "t1": 17.34, "text": "Stop treating your youth"}, {"t0": 17.34, "t1": 18.84, "text": "like a rehearsal."}, {"t0": 18.84, "t1": 19.52, "text": "The habits you build"}, {"t0": 19.52, "t1": 20.34, "text": "today,"}, {"t0": 20.34, "t1": 21.52, "text": "the circle you keep,"}, {"t0": 21.52, "t1": 22.34, "text": "and the discipline you"}, {"t0": 22.34, "t1": 23.86, "text": "master right now will"}, {"t0": 23.86, "t1": 25.02, "text": "dictate whether you conquer"}, {"t0": 25.02, "t1": 26.28, "text": "your dreams or watch"}, {"t0": 26.28, "t1": 27.34, "text": "someone else live them."}, {"t0": 27.34, "t1": 29.8, "text": "Build fiercely."}]