[{"t0": 0.0, "t1": 0.76, "text": "You do not rise"}, {"t0": 0.76, "t1": 1.62, "text": "to the level of"}, {"t0": 1.62, "t1": 2.84, "text": "your goals."}, {"t0": 2.84, "t1": 3.64, "text": "You fall to the"}, {"t0": 3.64, "t1": 5.3, "text": "level of your habits."}, {"t0": 5.3, "t1": 5.96, "text": "Every small,"}, {"t0": 5.96, "t1": 7.36, "text": "daily choice you make"}, {"t0": 7.36, "t1": 8.42, "text": "is either building the"}, {"t0": 8.42, "t1": 9.54, "text": "empire of your future"}, {"t0": 9.54, "t1": 10.92, "text": "or digging the grave"}, {"t0": 10.92, "t1": 12.56, "text": "of your potential."}, {"t0": 12.56, "t1": 13.76, "text": "Success isn't a miraculous"}, {"t0": 13.76, "t1": 14.92, "text": "event."}, {"t0": 14.92, "t1": 16.06, "text": "It's a compound interest"}, {"t0": 16.06, "t1": 17.46, "text": "of discipline."}, {"t0": 17.46, "t1": 18.32, "text": "If your daily routines"}, {"t0": 18.32, "t1": 19.64, "text": "are lazy,"}, {"t0": 19.64, "t1": 20.08, "text": "chaotic,"}, {"t0": 20.08, "t1": 21.3, "text": "and uninspired,"}, {"t0": 21.3, "t1": 22.2, "text": "your future will be"}, {"t0": 22.2, "t1": 23.16, "text": "too."}, {"t0": 23.16, "t1": 24.48, "text": "Upgrade your habits,"}, {"t0": 24.48, "t1": 25.38, "text": "take control of your"}, {"t0": 25.38, "t1": 26.04, "text": "daily actions,"}, {"t0": 26.04, "t1": 27.44, "text": "and force your destiny"}, {"t0": 27.44, "t1": 29.2, "text": "to change."}]