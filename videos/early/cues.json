[{"t0": 0.0, "t1": 1.02, "text": "Listen to me very"}, {"t0": 1.02, "t1": 2.22, "text": "carefully."}, {"t0": 2.22, "t1": 2.94, "text": "The life you've always"}, {"t0": 2.94, "t1": 3.96, "text": "dreamed of,"}, {"t0": 3.96, "t1": 4.96, "text": "it is not going"}, {"t0": 4.96, "t1": 5.82, "text": "to be handed to"}, {"t0": 5.82, "t1": 6.48, "text": "you."}, {"t0": 6.48, "t1": 7.3, "text": "It starts with the"}, {"t0": 7.3, "t1": 8.58, "text": "very first battle of"}, {"t0": 8.58, "t1": 9.52, "text": "your day,"}, {"t0": 9.52, "t1": 11.5, "text": "conquering your morning."}, {"t0": 11.5, "t1": 12.18, "text": "Have you ever wondered"}, {"t0": 12.18, "t1": 13.42, "text": "why legends like Apple"}, {"t0": 13.42, "t1": 14.9, "text": "CEO Tim Cook wake"}, {"t0": 14.9, "t1": 16.88, "text": "up at 3:45 AM?"}, {"t0": 16.88, "t1": 18.0, "text": "It's not about losing"}, {"t0": 18.0, "t1": 18.96, "text": "sleep."}, {"t0": 18.96, "t1": 19.92, "text": "It's about gaining an"}, {"t0": 19.92, "t1": 21.46, "text": "unfair advantage over your"}, {"t0": 21.46, "t1": 22.72, "text": "own limits."}, {"t0": 22.72, "t1": 23.34, "text": "While the rest of"}, {"t0": 23.34, "t1": 24.18, "text": "the world is fast"}, {"t0": 24.18, "t1": 24.96, "text": "asleep,"}, {"t0": 24.96, "t1": 26.1, "text": "wrapped in comfort and"}, {"t0": 26.1, "t1": 27.1, "text": "excuses,"}, {"t0": 27.1, "t1": 28.22, "text": "they are up building"}, {"t0": 28.22, "t1": 28.9, "text": "their empires."}, {"t0": 28.9, "t1": 30.44, "text": "When the morning is"}, {"t0": 30.44, "t1": 31.28, "text": "silent,"}, {"t0": 31.28, "t1": 32.54, "text": "your mind is sharp,"}, {"t0": 32.54, "t1": 33.04, "text": "and there are no"}, {"t0": 33.04, "t1": 34.16, "text": "distractions,"}, {"t0": 34.16, "t1": 36.32, "text": "you hold pure power."}, {"t0": 36.32, "t1": 37.6, "text": "That quiet hour is"}, {"t0": 37.6, "t1": 39.52, "text": "where winners are forged."}, {"t0": 39.52, "t1": 40.12, "text": "So let me ask"}, {"t0": 40.12, "t1": 40.62, "text": "you,"}, {"t0": 40.62, "t1": 41.52, "text": "how long are you"}, {"t0": 41.52, "t1": 42.06, "text": "going to let a"}, {"t0": 42.06, "t1": 43.0, "text": "warm bed and a"}, {"t0": 43.0, "t1": 44.26, "text": "snooze button steal your"}, {"t0": 44.26, "t1": 45.34, "text": "future?"}, {"t0": 45.34, "t1": 47.2, "text": "Stop waiting for permission."}, {"t0": 47.2, "t1": 48.16, "text": "Stop waiting for the"}, {"t0": 48.16, "t1": 49.62, "text": "right time."}, {"t0": 49.62, "t1": 50.42, "text": "Wake up,"}, {"t0": 50.42, "t1": 51.98, "text": "take absolute control,"}, {"t0": 51.98, "t1": 52.78, "text": "and show the world"}, {"t0": 52.78, "t1": 53.6, "text": "what you are truly"}, {"t0": 53.6, "t1": 54.94, "text": "capable of."}, {"t0": 54.94, "t1": 56.76, "text": "Your time is now."}, {"t0": 56.76, "t1": 59.0, "text": "Go and conquer!"}]