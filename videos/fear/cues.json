[{"t0": 0.0, "t1": 1.06, "text": "Listen to me very"}, {"t0": 1.06, "t1": 2.3, "text": "carefully."}, {"t0": 2.3, "t1": 3.62, "text": "Fear is nothing more"}, {"t0": 3.62, "t1": 4.48, "text": "than a ghost in"}, {"t0": 4.48, "t1": 5.86, "text": "your own head."}, {"t0": 5.86, "t1": 6.86, "text": "It has zero power"}, {"t0": 6.86, "t1": 8.22, "text": "over you unless you"}, {"t0": 8.22, "t1": 9.7, "text": "hand it the keys."}, {"t0": 9.7, "t1": 10.54, "text": "Think about the risks"}, {"t0": 10.54, "t1": 11.62, "text": "you refused to take"}, {"t0": 11.62, "t1": 12.42, "text": "because you were terrified"}, {"t0": 12.42, "t1": 13.94, "text": "of messing up."}, {"t0": 13.94, "t1": 14.9, "text": "How many dreams did"}, {"t0": 14.9, "t1": 15.9, "text": "you bury just to"}, {"t0": 15.9, "t1": 17.18, "text": "stay comfortable?"}, {"t0": 17.18, "t1": 18.36, "text": "Comfort is a silent"}, {"t0": 18.36, "t1": 19.42, "text": "killer."}, {"t0": 19.42, "t1": 20.34, "text": "It whispers safety,"}, {"t0": 20.34, "t1": 21.76, "text": "but it murders your"}, {"t0": 21.76, "t1": 22.88, "text": "potential."}, {"t0": 22.88, "t1": 24.12, "text": "Every single person who"}, {"t0": 24.12, "t1": 25.76, "text": "ever achieved greatness tasted"}, {"t0": 25.76, "t1": 27.98, "text": "failure over and over"}, {"t0": 27.98, "t1": 28.9, "text": "again."}, {"t0": 28.9, "t1": 29.82, "text": "The only difference between"}, {"t0": 29.82, "t1": 30.76, "text": "them and the people"}, {"t0": 30.76, "t1": 31.36, "text": "who stay on the"}, {"t0": 31.36, "t1": 32.68, "text": "sidelines is that they"}, {"t0": 32.68, "t1": 33.64, "text": "refuse to let a"}, {"t0": 33.64, "t1": 35.64, "text": "stumble stop their race."}, {"t0": 35.64, "t1": 36.28, "text": "So what if you"}, {"t0": 36.28, "t1": 37.08, "text": "fall?"}, {"t0": 37.08, "t1": 37.68, "text": "So what if it"}, {"t0": 37.68, "t1": 38.42, "text": "doesn't work out on"}, {"t0": 38.42, "t1": 39.66, "text": "the first try?"}, {"t0": 39.66, "t1": 40.6, "text": "That is not your"}, {"t0": 40.6, "t1": 41.4, "text": "end."}, {"t0": 41.4, "t1": 43.2, "text": "That is your education."}, {"t0": 43.2, "t1": 44.86, "text": "Stop playing it safe."}, {"t0": 44.86, "t1": 46.08, "text": "Stop letting what if"}, {"t0": 46.08, "t1": 47.86, "text": "steal your destiny."}, {"t0": 47.86, "t1": 49.04, "text": "Step into the arena."}, {"t0": 49.04, "t1": 50.14, "text": "Face the fear head"}, {"t0": 50.14, "t1": 51.4, "text": "on and build something"}, {"t0": 51.4, "t1": 52.84, "text": "legendary."}, {"t0": 52.84, "t1": 54.02, "text": "You are stronger than"}, {"t0": 54.02, "t1": 55.0, "text": "your fears."}, {"t0": 55.0, "t1": 56.6, "text": "Now go prove it."}]